# ── Synthure ─────────────────────────────────────────────────────────────────
# The synthesize route requires an Anthropic key. It runs the four writer
# agents, the verifier, the constitution critic, and the orchestrator as real
# Claude calls. There is no offline path: without a key the on device de
# identification and NER still run and display, then the pipeline stops with an
# honest "synthesis service is not configured" message rather than degrading to
# a weaker method.
#
# For local dev, put this in frontend/.env.local
ANTHROPIC_API_KEY=sk-ant-...

# Optional. Points at the trained ICD coder and faithfulness service (the
# serve/ Hugging Face Space). When set, the neural retriever plus reranker and
# the cross encoder faithfulness scorer are used and their numbers populate the
# evals page. When unset, the shipped lexical linker runs and those metrics stay
# marked deferred.
# SYNTHURE_MODEL_API=https://your-space.hf.space
